{
  "name": "authentichadithapp",
  "main": "expo-router/entry",
  "version": "1.1.3",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --passWithNoTests",
    "qa:routes": "jest __tests__/navigation/route-integrity.test.ts --verbose",
    "qa:types": "tsc --noEmit",
    "qa:lint": "expo lint",
    "qa:test": "jest --verbose --coverage",
    "qa:release-guard": "node scripts/qa-release-guard.mjs",
    "qa:build": "npx eas-cli build --platform ios --profile production --non-interactive --no-wait",
    "qa:report": "npm run qa:types 2>&1; npm run qa:lint 2>&1; npm run qa:test 2>&1; echo '--- QA Complete ---'",
    "qa:audit:env": "node scripts/qa-audit-env.mjs",
    "qa:audit:routes": "node scripts/qa-audit-routes.mjs",
    "qa:audit:deps": "node scripts/qa-audit-deps.mjs",
    "qa:audit:report": "node scripts/qa-audit-report.mjs",
    "qa:revenuecat": "node scripts/verify-revenuecat-offerings.mjs",
    "qa:truthserum": "npm run qa:release-guard && npm run qa:audit:env && npm run qa:audit:routes && npm run qa:audit:deps && npm run qa:audit:report",
    "worker:health": "test -f CLAUDE.md && test -d .claude/commands && test -d .claude/rules && echo 'worker:health OK'"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.2.9",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.62.11",
    "ai": "^4.3.19",
    "date-fns": "^3.3.1",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.16.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^9.9.0",
    "react-native-purchases-ui": "^9.9.0",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-reanimated": "~3.18.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "^5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}
